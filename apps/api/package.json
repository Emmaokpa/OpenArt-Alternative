{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/migrate.js",
    "db:studio": "drizzle-kit studio",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "seed:prod": "node dist/seed.js",
    "worker:io": "node --env-file-if-exists=../../.env --import tsx src/worker-io.ts",
    "worker:media": "node --env-file-if-exists=../../.env --import tsx src/worker-media.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/lib-storage": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@better-auth/drizzle-adapter": "1.7.23",
    "@bull-board/api": "9.13.1",
    "@bull-board/express": "9.13.1",
    "better-auth": "1.7.23",
    "bullmq": "6.7.6",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
