# Copy to .env in the repo root. Never commit .env.
# Values here are local-development defaults only.

# --- API (apps/api) -------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres (docker-compose.dev.yml in infra/)
DATABASE_URL=postgres://app:app@localhost:5432/app

# Redis (docker-compose.dev.yml in infra/)
REDIS_URL=redis://localhost:6379

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# "fake" keeps development free; real provider calls require "real".
PROVIDER_MODE=fake

# --- Web (apps/web) -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
