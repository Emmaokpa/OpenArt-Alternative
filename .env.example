# Copy to .env in the repo root. Never commit .env.
# Values here are local-development defaults only.

# --- API (apps/api) -------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres (docker-compose.dev.yml in infra/)
DATABASE_URL=postgres://app:app@localhost:5432/app

# Redis (docker-compose.dev.yml in infra/)
REDIS_URL=redis://localhost:6379

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# "fake" keeps development free; real provider calls require "real".
PROVIDER_MODE=fake

# --- Auth -----------------------------------------------------------------
# Better Auth signs cookies with this. Development falls back to a throwaway
# secret; production requires a real 32+ character value.
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
APP_URL=http://localhost:3000

# Signup email verification and password reset. Without a key, emails are
# logged to the API console instead of sent. Production requires a key.
# RESEND_API_KEY=
EMAIL_FROM=OpenArt <no-reply@example.com>

# Google login is enabled only when both values are present.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile. When set, sign-up / sign-in / password reset require a
# valid token in the x-captcha-response header. Production requires a key.
# TURNSTILE_SECRET_KEY=

# Comma-separated emails promoted to the admin role on signup.
# ADMIN_EMAILS=

# Development convenience; forced to 0 in production.
SIGNUP_GRANT_CREDITS=1000

# --- Object storage (LocalStack locally, R2 in production) ----------------
# Production: https://<account-id>.r2.cloudflarestorage.com and region "auto".
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET_PRIVATE=app-private
S3_BUCKET_PUBLIC=app-public
# R2 needs path-style off; LocalStack needs it on.
S3_FORCE_PATH_STYLE=true

# --- Fake provider (development and tests) --------------------------------
FAKE_DELAY_MS=1500
FAKE_FAIL_RATE=0
FAKE_TIMEOUT_RATE=0

# --- Job polling ----------------------------------------------------------
JOB_POLL_INTERVAL_MS=3000
JOB_POLL_MAX_MS=30000

# --- Web (apps/web) -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
